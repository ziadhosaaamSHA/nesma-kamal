"use client";

import React, { useState, useEffect } from "react";
import { usePathname } from "next/navigation";
import { TransitionLink } from "../transitions/TransitionLink";
import { motion, AnimatePresence } from "framer-motion";
import { List, X, Globe, InstagramLogo, LinkedinLogo } from "@phosphor-icons/react";
import { useLanguage } from "@/context/LanguageContext";
import NavItem from "./NavItem";
import { navigationItems } from "./navigationData";
import type { NavigationItem } from "@/app/types/navigation";

const Header = () => {
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isInBookSection, setIsInBookSection] = useState(false);
  const { lang, setLang } = useLanguage();
  const [activeDropdown, setActiveDropdown] = useState<string | null>(null);
  const [expandedMobileItem, setExpandedMobileItem] = useState<string | null>(null);
  const pathname = usePathname?.() ?? "";

  useEffect(() => {
    document.body.style.overflow = isMobileMenuOpen ? "hidden" : "unset";
    return () => {
      document.body.style.overflow = "unset";
    };
  }, [isMobileMenuOpen]);
  useEffect(() => {
    if (pathname !== "/") return;

    const bookSection = document.getElementById("book-section");
    if (!bookSection) return;
    const isMobile = window.matchMedia("(max-width: 1023px)").matches;

    if (isMobile) {
      const mobileStartOffset = 260;
      const mobileEndOffset = 110;

      const handleMobileScroll = () => {
        const sectionRect = bookSection.getBoundingClientRect();
        const isInMobileBookRange =
          sectionRect.top <= window.innerHeight - mobileStartOffset &&
          sectionRect.bottom >= mobileEndOffset;
        setIsInBookSection(isInMobileBookRange);
      };

      handleMobileScroll();
      window.addEventListener("scroll", handleMobileScroll, { passive: true });
      return () => window.removeEventListener("scroll", handleMobileScroll);
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        setIsInBookSection(entry.isIntersecting);
      },
      { threshold: 0.25 }
    );

    observer.observe(bookSection);
    return () => observer.disconnect();
  }, [pathname]);
  const leftNav = navigationItems.slice(0, 3);
  const rightNav = navigationItems.slice(3);
  const useBurgundyTone = pathname === "/" && isInBookSection;

  const isItemCurrent = (item: NavigationItem) =>
    !!item.href && pathname === item.href;

  return (
    <motion.header
      initial={{ y: -100 }}
      animate={{ y: 0 }}
      transition={{ duration: 0.9, ease: [0.16, 1, 0.3, 1] }}
      className={`fixed top-0 left-0 w-full z-50 ${
        useBurgundyTone ? "bg-brand-burgundy" : "bg-brand-primary"
      } transition-all duration-500 border-b border-transparent`}
      style={{ height: "var(--header-height, 80px)" }}
    >
      <div className="max-w-[90rem] h-full mx-auto px-6 md:px-10 lg:px-12">
        <div className="grid h-full grid-cols-2 lg:grid-cols-3 items-center">
          {/* Left Nav (Desktop/Tablet) */}
          <nav className="hidden lg:flex items-center gap-1 xl:gap-2">
            {leftNav.map((item) => (
              <div
                key={item.label}
                className="relative"
                onMouseEnter={() => item.dropdown && setActiveDropdown(item.label)}
                onMouseLeave={() => setActiveDropdown(null)}
              >
                <NavItem
                  item={item}
                  lang={lang}
                  isActive={activeDropdown === item.label}
                  isCurrentPage={isItemCurrent(item)}
                  useBurgundyTone={useBurgundyTone}
                  align="left"
                />
              </div>
            ))}
          </nav>

          {/* Center: Logo */}
          <div className="flex justify-start lg:justify-center">
            <TransitionLink href="/">
              <h1 className="text-xl md:text-2xl lg:text-3xl font-display logo-spacing text-brand-parchment transition-opacity hover:opacity-80">
                nesma
              </h1>
            </TransitionLink>
          </div>

          {/* Right Nav (Desktop/Tablet) */}
          <div className="hidden lg:flex items-center justify-end gap-1 xl:gap-2">
            {rightNav.map((item) => (
              <div
                key={item.label}
                className="relative"
                onMouseEnter={() => item.dropdown && setActiveDropdown(item.label)}
                onMouseLeave={() => setActiveDropdown(null)}
              >
                <NavItem
                  item={item}
                  lang={lang}
                  isActive={activeDropdown === item.label}
                  isCurrentPage={isItemCurrent(item)}
                  useBurgundyTone={useBurgundyTone}
                  align="right"
                />
              </div>
            ))}

            <button
              onClick={() => setLang(lang === "en" ? "ar" : "en")}
              className="flex items-center gap-1.5 text-[0.625rem] uppercase  transition-all ml-2 lg:ml-4 px-3 py-2 rounded-full border border-brand-parchment/25 text-brand-parchment/85 hover:text-brand-parchment hover:bg-brand-parchment/10 hover:border-brand-parchment/40 active:scale-[0.96]"
            >
              <Globe size="1rem" />
              {lang === "en" ? "AR" : "EN"}
            </button>
          </div>

          {/* Mobile Menu Toggle */}
          <div className="lg:hidden flex justify-end">
            <button
              onClick={() => setIsMobileMenuOpen(true)}
              className="p-2 -mr-2 rounded-full text-brand-parchment hover:bg-brand-parchment/10 active:scale-90 transition-all"
              aria-label="Open menu"
            >
              <List size="1.625rem" />
            </button>
          </div>
        </div>
      </div>

      {/* Mobile Menu */}
      <AnimatePresence mode="wait">
        {isMobileMenuOpen && (
          <motion.div
            initial={{ y: "100%" }}
            animate={{ y: 0 }}
            exit={{ y: "100%" }}
            transition={{ duration: 0.6, ease: [0.19, 1, 0.22, 1] }}
            className="fixed inset-0 z-[60] bg-brand-primary flex flex-col p-6 sm:p-8 md:p-16 overflow-y-auto"
          >
            <div className="flex justify-between items-center mb-14 sm:mb-16 md:mb-20">
              <h1 className="text-xl sm:text-2xl font-display logo-spacing text-brand-parchment">
                nesma
              </h1>
              <button
                onClick={() => setIsMobileMenuOpen(false)}
                className="w-11 h-11 sm:w-12 sm:h-12 rounded-full border border-brand-parchment/30 flex items-center justify-center text-brand-parchment hover:bg-brand-parchment hover:text-brand-primary active:scale-90 transition-all duration-300"
                aria-label="Close menu"
              >
                <X size="1.375rem" />
              </button>
            </div>

            <nav className="flex flex-col gap-6 sm:gap-8 flex-grow">
              {navigationItems.map((item, index) => (
                <motion.div
                  initial={{ opacity: 0, x: -16 }}
                  animate={{ opacity: 1, x: 0 }}
                  transition={{ delay: 0.15 + index * 0.05, duration: 0.4, ease: [0.16, 1, 0.3, 1] }}
                  key={item.label}
                >
                  <NavItem
                    item={item}
                    lang={lang}
                    isMobile
                    isCurrentPage={isItemCurrent(item)}
                    expandedMobileItem={expandedMobileItem}
                    setExpandedMobileItem={setExpandedMobileItem}
                    setIsMobileMenuOpen={setIsMobileMenuOpen}
                  />
                </motion.div>
              ))}
            </nav>

            <div className="pt-10 sm:pt-12 border-t border-brand-parchment/10 flex flex-col-reverse sm:flex-row justify-between items-center gap-6 sm:gap-8">
              <p className="text-[0.625rem] uppercase  text-brand-parchment/40">
                &copy; 2026 Nesma Kamal
              </p>
              <div className="flex items-center gap-5 sm:gap-6">
                <a
                  href="https://instagram.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  className="text-brand-parchment/60 hover:text-brand-parchment active:scale-90 transition-all"
                  aria-label="Instagram"
                >
                  <InstagramLogo size="1.375rem" />
                </a>
                <a
                  href="https://linkedin.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  className="text-brand-parchment/60 hover:text-brand-parchment active:scale-90 transition-all"
                  aria-label="LinkedIn"
                >
                  <LinkedinLogo size="1.375rem" />
                </a>
                <button
                  onClick={() => setLang(lang === "en" ? "ar" : "en")}
                  className="text-brand-parchment/75 hover:text-brand-parchment active:scale-95 transition-all uppercase text-[0.6875rem]  flex items-center gap-1.5 rounded-full border border-brand-parchment/25 px-3 py-1.5"
                >
                  <Globe size="1rem" />
                  {lang === "en" ? "Arabic" : "English"}
                </button>
              </div>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </motion.header>
  );
};

export default Header;